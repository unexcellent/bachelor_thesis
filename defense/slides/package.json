{
  "name": "defense-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "pnpm export:slides && node scripts/notes.mjs && typst compile --root . scripts/handout.typ defense.pdf",
    "export:slides": "mkdir -p build && slidev export --dark --per-slide --wait 1500 --output build/slides.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.50.0"
  }
}
