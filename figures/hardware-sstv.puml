@startuml
mainframe ibd [block] SstvSystem [internal structure]
left to right direction
skinparam componentStyle rectangle
skinparam nodesep 45
skinparam ranksep 80
skinparam defaultFontName Helvetica Neue
skinparam defaultFontSize 20

' In left-to-right layout, portin lands on the LEFT edge of a block and
' portout on the RIGHT edge; they render identically, so the keyword is
' chosen for layout, not semantics.
'
' Some port labels are padded with invisible non-breaking spaces (U+00A0):
' graphviz centers each port square over its label, so equal label widths
' per block side keep the squares vertically aligned on the border.
component ": SstvSystem" <<block>> as sstv {
  portin "       pwr       "          as b_pwr
  portin "uart : Rs485" as b_uart
  portin " audio : I2s "  as b_audio

  component "mcu : ESP32-P4" <<block>> as mcu {
    portin  "       pwr       "                 as mcu_pwr
    portin  "uart : Rs485"        as mcu_uart
    portin  " audio : I2s "         as mcu_audio
    portout "thermal_data : Spi"  as mcu_thdata
    portout " thermal_ctrl : I2c "  as mcu_thctrl
    portout "    csi : MipiCsi2    "      as mcu_csi
  }
  component "rgb_cam : SC850SL" <<block>> as rgb {
    portin "csi : MipiCsi2" as rgb_csi
  }
  component "thermal_cam : MI1602" <<block>> as thermal {
    portin " ctrl : I2c " as th_ctrl
    portin "data : Spi" as th_data
  }
}

' left-to-right mode rotates direction hints: -down-> renders rightward
b_pwr      -down->  mcu_pwr    : «itemFlow» power
b_uart     <-down-> mcu_uart   : «itemFlow» messages
b_audio    <-down-  mcu_audio  : «itemFlow» audio_samples
mcu_csi    <-down-> rgb_csi    : «itemFlow» power, commands,\nimage_data
mcu_thctrl <-down-> th_ctrl    : «itemFlow» commands
mcu_thdata -down->  th_data    : «itemFlow» power, image_data
@enduml
